{
  "name": "clinic-budget-app",
  "version": "1.0.0",
  "description": "Offline healthcare budget planning application",
  "main": "public/electron.js",
  "homepage": "./",
  "scripts": {
    "serve": "vue-cli-service serve",
    "build": "vue-cli-service build",
    "dev": "concurrently \"npm run serve\" \"wait-on http://localhost:8080 && electron .\"",
    "electron": "electron .",
    "build-electron": "vue-cli-service build && electron-builder",
    "build-win": "vue-cli-service build && electron-builder --win --publish never",
    "build-win-portable": "vue-cli-service build && electron-builder --win -p never --config.win.certificateFile=null",
    "build-mac": "vue-cli-service build && electron-builder --mac",
    "build-clean": "rimraf dist dist_electron && npm run build-win",
    "lint": "vue-cli-service lint"
  },
  "dependencies": {
    "better-sqlite3": "^9.0.0",
    "electron-store": "^8.1.0",
    "exceljs": "^4.3.0",
    "vue": "^3.3.4",
    "vue-router": "^4.2.4",
    "win": "^0.0.1"
  },
  "devDependencies": {
    "@babel/core": "^7.22.5",
    "@babel/preset-env": "^7.22.5",
    "@vue/cli-service": "^5.0.8",
    "@vue/compiler-sfc": "^3.3.4",
    "babel-loader": "^9.1.2",
    "concurrently": "^8.1.0",
    "electron": "^40.4.1",
    "electron-builder": "^26.7.0",
    "electron-is-dev": "^2.0.0",
    "eslint": "^8.43.0",
    "eslint-plugin-vue": "^9.14.0",
    "rimraf": "^5.0.0",
    "sass": "^1.63.6",
    "sass-loader": "^13.2.2",
    "wait-on": "^7.0.1",
    "webpack": "^5.88.0",
    "webpack-cli": "^5.1.4"
  }
}
